# Sanjeevani — Environment Variables Example
# Copy this file to .env and fill in values before running

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://sanjeevani:sanjeevani_secure_pass@localhost:5432/sanjeevani_db?schema=public"

# ─── NestJS API ───────────────────────────────────────────────────────────────
PORT=3000
JWT_SECRET="sanjeevani_jwt_hackathon_secret_change_in_production"

# ─── AI Service ───────────────────────────────────────────────────────────────
# When running with Docker Compose, use: http://ai-service:8000
# When running locally without Docker, use: http://localhost:8000
AI_SERVICE_URL="http://localhost:8000"

# ─── Mobile App (Expo) ────────────────────────────────────────────────────────
# API base URL for mobile app
# - Expo on Android emulator:  http://10.0.2.2:3002/api/v1
# - Expo on physical device:   http://<YOUR_LAN_IP>:3002/api/v1
# - Docker Compose (web):      http://localhost:3002/api/v1
EXPO_PUBLIC_API_URL="http://localhost:3002/api/v1"
