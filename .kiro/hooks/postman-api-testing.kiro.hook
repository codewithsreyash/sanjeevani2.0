{
  "enabled": true,
  "name": "API Postman Testing",
  "description": "Monitors API source code and config changes in the Sanjeevani project and automatically runs Postman collection tests to validate functionality",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "apps/api/src/*.ts",
      "apps/api/prisma/*.prisma",
      "apps/api/package.json",
      "apps/ai-service/app/*.py",
      "apps/ai-service/requirements.txt",
      "openapi.yaml",
      "openapi.yml",
      "swagger.yaml",
      "swagger.yml"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code or configuration has been modified. Please retrieve the contents of the .postman.json file. If the file does not exist or is empty, create a Postman collection for the API. If it exists, get the collection ID and run the collection, showing me the results and propose fixes for any errors found."
  }
}